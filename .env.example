# ---------------------------------------------------------------
# INFRAINV · Variables de entorno
# Local: copia este archivo a ".env" y completa los valores.
# Render: configúralas en el panel (Environment) o vía render.yaml.
# NUNCA subas el archivo .env real a Git.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=3000                      # Render lo define automáticamente

# --- Base de datos (opción A, recomendada): una sola URL ---------
# En Render usa la "Internal Database URL" del servicio PostgreSQL.
DATABASE_URL=postgres://usuario:password@localhost:5432/infrainv
# Pon true solo si te conectas con la URL EXTERNA de Render u otro proveedor que exija SSL
DB_SSL=false

# --- Base de datos (opción B): variables sueltas (si no hay DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=infrainv

# Pool de conexiones (opcional)
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# --- Seguridad ----------------------------------------------------
# Mínimo 32 caracteres. Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Administrador inicial (se crea solo si el correo no existe) --
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@infrainv.com
ADMIN_PASSWORD=                # mínimo 8 caracteres; cámbiala tras el primer ingreso

# --- Opciones ------------------------------------------------------
APP_TIMEZONE=America/El_Salvador   # define qué es "hoy" para caducidades y pedidos
AUTO_MIGRATE=true                  # aplica db/schema.sql al arrancar (idempotente)
SEED_DEMO=false                    # true = carga datos de ejemplo si las tablas están vacías
# CORS_ORIGIN=https://mi-front.com # solo si el frontend se aloja en OTRO dominio
